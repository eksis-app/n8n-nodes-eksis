{
	"name": "n8n-nodes-eksis",
	"version": "0.1.0",
	"description": "n8n nodes for eksis: schedule and publish social posts, manage media, answer comments, and start workflows from eksis events.",
	"license": "MIT",
	"homepage": "https://eksis.io",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"eksis",
		"social media",
		"scheduling",
		"instagram",
		"tiktok",
		"youtube"
	],
	"author": {
		"name": "eksis",
		"email": "support@eksis.io",
		"url": "https://eksis.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/eksis-app/n8n-nodes-eksis.git"
	},
	"bugs": {
		"url": "https://github.com/eksis-app/n8n-nodes-eksis/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/EksisApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Eksis/Eksis.node.js",
			"dist/nodes/EksisTrigger/EksisTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
